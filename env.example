# Copia este archivo como `.env` (solo valores de desarrollo).
# Nada de lo que empieza por EXPO_PUBLIC_ es secreto: queda dentro del APK.
# Aquí NO va ninguna clave de Firebase: el login lo hace la API (repo aparte).

# URL pública de la API desplegada en Vercel (valor de ejemplo, cámbialo por el tuyo)
EXPO_PUBLIC_API_URL=https://ejemplo-horario-api.vercel.app
