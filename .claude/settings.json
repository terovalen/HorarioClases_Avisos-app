{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": [],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(./.claude/**)",
      "Edit(./.claude/**)",
      "Edit(./.env*)",
      "Bash(sudo:*)",
      "Bash(sudo)",
      "Bash(curl:*)",
      "Bash(curl)",
      "Bash(wget:*)",
      "Bash(wget)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(vercel:*)",
      "Bash(eas:*)",
      "Bash(./node_modules/.bin/vercel:*)",
      "Bash(./node_modules/.bin/eas:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push :*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx expo install:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)",
      "Bash(vercel:*)",
      "Bash(eas:*)"
    ],
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx jest:*)",
      "Bash(npx expo start:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "objects.githubusercontent.com",
        "api.expo.dev",
        "expo.dev"
      ]
    },
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": ["."]
    }
  },
  "allowUnsandboxedCommands": false,
  "disableBypassPermissionsMode": "disable"
}
